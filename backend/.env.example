NODE_ENV=development
PORT=4000
DB_HOST=your_aiven_host
DB_PORT=your_aiven_port
DB_USER=your_aiven_username
DB_PASSWORD=your_aiven_password
DB_NAME=eventx_db
DATABASE_URL=mysql://<AIVEN_USERNAME>:<URL_ENCODED_PASSWORD>@<AIVEN_HOST>:<AIVEN_PORT>/<AIVEN_DATABASE>?ssl-mode=REQUIRED&sslaccept=accept_invalid_certs
CLIENT_ORIGIN=http://localhost:5173
# Generate separate secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
PAYMENT_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5242880
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
